GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-3.6-flash
ACCESS_PASSWORD=elige_una_contraseña_segura
# Railway asigna PORT automáticamente. Este valor es solo para desarrollo local.
PORT=3000
# Opcionales: límites de uso de Gemini (por sesión cada 15 min y total por hora).
# CHAT_REQUESTS_PER_SESSION=30
# CHAT_REQUESTS_PER_HOUR=300
# Opcional: razonamiento de Gemini (minimal, low, medium, high, default). Sin valor, low en Gemini 3
# (responde varias veces más rápido); "default" usa el del modelo.
# GEMINI_THINKING_LEVEL=low

# Modelos de lenguaje activos (ids separados por comas). Ver docs/api.md#modelos-de-lenguaje.
# Cada adaptador lee sus propias variables, más abajo.
LLM_PROVIDERS=claude-cli,gemini
# Cuál responde si la petición no indica `provider`. Por defecto, el primero de la lista.
LLM_DEFAULT_PROVIDER=claude-cli

# --- Adaptador claude-cli: CLI de Claude Code autenticada en esta máquina (solo local) ---
CLAUDE_CLI_MODEL=haiku
# CLAUDE_CLI_PATH=
# CLAUDE_CLI_MAX_OUTPUT_TOKENS=64000

# --- Adaptador gemini: API de Google AI Studio ---
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-3.6-flash

# Contraseña del frontend web.
ACCESS_PASSWORD=elige_una_contraseña_segura

# Tokens para clientes externos de la API: nombre:token separados por comas.
# Cada token debe tener al menos 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Ver docs/api.md.
API_TOKENS=mi-cliente:reemplaza_por_un_token_aleatorio_de_32_caracteres_o_mas

# Opcional: orígenes de navegador que pueden llamar a la API (CORS), separados por comas.
# CORS_ORIGINS=https://mi-app.example.com

# Railway asigna PORT automáticamente. Este valor es solo para desarrollo local.
PORT=3000
# Guarda la respuesta cruda del LLM en .experiments/ (true para activar)
LLM_RAW_DEBUG=false
